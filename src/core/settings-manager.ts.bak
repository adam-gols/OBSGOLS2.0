/**
 * Settings Manager - Configuration persistence and management
 * Handles all widget configuration with localStorage persistence
 */

import { logger } from '../utils/logger.js';
import { eventBus, Events } from './event-manager.js';
import { GOLS_CONSTANTS } from '../utils/constants.js';

export interface GoogleSheetsSettings {
  fileCabinetUrl: string;
  serviceAccountCredentials?: string; // JSON string
}

export interface OBSSettings {
  host: string;
  port: number;
  password?: string;
  enabled: boolean;
}

export interface SingularLiveSettings {
  enabled: boolean;
  dataStreamEndpoint?: string;
  privateToken?: string;
  updateInterval: number;
}

export interface UISettings {
  debugMode: boolean;
  theme: 'default' | 'dark' | 'light';
  autoSave: boolean;
}

export interface SessionState {
  lastSelectedEvent?: string;
  lastSelectedSiteStream?: string;
  currentGameIndex?: number;
}

export interface WidgetSettings {
  googleSheets: GoogleSheetsSettings;
  obs: OBSSettings;
  singularLive: SingularLiveSettings;
  ui: UISettings;
  session: SessionState;
  version: string;
}

export class SettingsManager {
  private static instance: SettingsManager;
  private settings: WidgetSettings;
  private readonly STORAGE_KEY = 'gols_widget_settings';
  private readonly SETTINGS_VERSION = '1.0.0';
  
  private constructor() {
    this.settings = this.getDefaultSettings();
    this.loadSettings();
    
    log.debug('SettingsManager initialized', { 
      module: 'SETTINGS',
      data: { version: this.SETTINGS_VERSION }
    });
  }

  public static getInstance(): SettingsManager {
    if (!SettingsManager.instance) {
      SettingsManager.instance = new SettingsManager();
    }
    return SettingsManager.instance;
  }

  /**
   * Get default settings configuration
   */
  private getDefaultSettings(): WidgetSettings {
    return {
      googleSheets: {
        fileCabinetUrl: GOLS_CONSTANTS.DEFAULT_FILE_CABINET_URL
      },
      obs: {
        host: GOLS_CONSTANTS.DEFAULT_OBS_HOST,
        port: GOLS_CONSTANTS.DEFAULT_OBS_PORT,
        enabled: true
      },
      singularLive: {
        enabled: false,
        updateInterval: 5000 // 5 seconds
      },
      ui: {
        debugMode: import.meta.env.DEV,
        theme: 'default',
        autoSave: true
      },
      session: {},
      version: this.SETTINGS_VERSION
    };
  }

  /**
   * Load settings from localStorage
   */
  private loadSettings(): void {
    try {
      const storedSettings = localStorage.getItem(this.STORAGE_KEY);
      
      if (storedSettings) {
        const parsed = JSON.parse(storedSettings) as WidgetSettings;
        
        // Merge with defaults to handle new settings
        this.settings = this.mergeWithDefaults(parsed);
        
        log.info('Settings loaded from localStorage', {
          module: 'SETTINGS',
          action: 'LOAD',
          data: { version: this.settings.version }
        });
      } else {
        log.info('No saved settings found, using defaults', {
          module: 'SETTINGS',
          action: 'LOAD_DEFAULTS'
        });
      }
      
      eventBus.emit(Events.SETTINGS_LOADED, this.settings);
      
    } catch (error) {
      log.error('Failed to load settings, using defaults', {
        module: 'SETTINGS',
        action: 'LOAD_ERROR'
      }, error as Error);
      
      this.settings = this.getDefaultSettings();
    }
  }

  /**
   * Merge loaded settings with defaults to handle version upgrades
   */
  private mergeWithDefaults(loaded: Partial<WidgetSettings>): WidgetSettings {
    const defaults = this.getDefaultSettings();
    
    return {
      googleSheets: { ...defaults.googleSheets, ...loaded.googleSheets },
      obs: { ...defaults.obs, ...loaded.obs },
      singularLive: { ...defaults.singularLive, ...loaded.singularLive },
      ui: { ...defaults.ui, ...loaded.ui },
      session: { ...defaults.session, ...loaded.session },
      version: this.SETTINGS_VERSION
    };
  }

  /**
   * Save settings to localStorage
   */
  public saveSettings(): void {
    try {
      const serialized = JSON.stringify(this.settings, null, 2);
      localStorage.setItem(this.STORAGE_KEY, serialized);
      
      log.info('Settings saved to localStorage', {
        module: 'SETTINGS',
        action: 'SAVE',
        data: { size: serialized.length }
      });
      
      eventBus.emit(Events.SETTINGS_SAVED, this.settings);
      
    } catch (error) {
      log.error('Failed to save settings', {
        module: 'SETTINGS',
        action: 'SAVE_ERROR'
      }, error as Error);
      
      eventBus.emit(Events.WIDGET_ERROR, {
        source: 'SettingsManager',
        message: 'Failed to save settings',
        error
      });
    }
  }

  /**
   * Get all settings
   */
  public getSettings(): WidgetSettings {
    return { ...this.settings };
  }

  /**
   * Get specific settings section
   */
  public getGoogleSheetsSettings(): GoogleSheetsSettings {
    return { ...this.settings.googleSheets };
  }

  public getOBSSettings(): OBSSettings {
    return { ...this.settings.obs };
  }

  public getSingularLiveSettings(): SingularLiveSettings {
    return { ...this.settings.singularLive };
  }

  public getUISettings(): UISettings {
    return { ...this.settings.ui };
  }

  public getSessionState(): SessionState {
    return { ...this.settings.session };
  }

  /**
   * Update specific settings sections
   */
  public updateGoogleSheetsSettings(updates: Partial<GoogleSheetsSettings>): void {
    const oldSettings = { ...this.settings.googleSheets };
    this.settings.googleSheets = { ...this.settings.googleSheets, ...updates };
    
    log.info('Google Sheets settings updated', {
      module: 'SETTINGS',
      action: 'UPDATE_GOOGLE_SHEETS',
      data: { updates }
    });
    
    this.notifySettingsChanged('googleSheets', oldSettings, this.settings.googleSheets);
    this.saveSettings();
  }

  public updateOBSSettings(updates: Partial<OBSSettings>): void {
    const oldSettings = { ...this.settings.obs };
    this.settings.obs = { ...this.settings.obs, ...updates };
    
    log.info('OBS settings updated', {
      module: 'SETTINGS',
      action: 'UPDATE_OBS',
      data: { updates }
    });
    
    this.notifySettingsChanged('obs', oldSettings, this.settings.obs);
    this.saveSettings();
  }

  public updateSingularLiveSettings(updates: Partial<SingularLiveSettings>): void {
    const oldSettings = { ...this.settings.singularLive };
    this.settings.singularLive = { ...this.settings.singularLive, ...updates };
    
    log.info('Singular Live settings updated', {
      module: 'SETTINGS',
      action: 'UPDATE_SINGULAR_LIVE',
      data: { updates }
    });
    
    this.notifySettingsChanged('singularLive', oldSettings, this.settings.singularLive);
    this.saveSettings();
  }

  public updateUISettings(updates: Partial<UISettings>): void {
    const oldSettings = { ...this.settings.ui };
    this.settings.ui = { ...this.settings.ui, ...updates };
    
    log.info('UI settings updated', {
      module: 'SETTINGS',
      action: 'UPDATE_UI',
      data: { updates }
    });
    
    this.notifySettingsChanged('ui', oldSettings, this.settings.ui);
    this.saveSettings();
  }

  public updateSessionState(updates: Partial<SessionState>): void {
    const oldState = { ...this.settings.session };
    this.settings.session = { ...this.settings.session, ...updates };
    
    log.debug('Session state updated', {
      module: 'SETTINGS',
      action: 'UPDATE_SESSION',
      data: { updates }
    });
    
    this.notifySettingsChanged('session', oldState, this.settings.session);
    this.saveSettings();
  }

  /**
   * Notify settings change
   */
  private notifySettingsChanged(section: string, oldValue: any, newValue: any): void {
    eventBus.emit(Events.SETTINGS_CHANGED, {
      section,
      oldValue,
      newValue,
      timestamp: new Date()
    });
  }

  /**
   * Reset settings to defaults
   */
  public resetToDefaults(): void {
    log.warn('Resetting all settings to defaults', {
      module: 'SETTINGS',
      action: 'RESET'
    });
    
    this.settings = this.getDefaultSettings();
    this.saveSettings();
  }

  /**
   * Reset specific section to defaults
   */
  public resetSectionToDefaults(section: keyof WidgetSettings): void {
    const defaults = this.getDefaultSettings();
    const oldValue = this.settings[section];
    
    (this.settings as any)[section] = defaults[section];
    
    log.warn(`Reset ${section} settings to defaults`, {
      module: 'SETTINGS',
      action: 'RESET_SECTION',
      data: { section }
    });
    
    this.notifySettingsChanged(section, oldValue, this.settings[section]);
    this.saveSettings();
  }

  /**
   * Export settings as JSON
   */
  public exportSettings(): string {
    return JSON.stringify(this.settings, null, 2);
  }

  /**
   * Import settings from JSON
   */
  public importSettings(settingsJson: string): void {
    try {
      const imported = JSON.parse(settingsJson) as Partial<WidgetSettings>;
      this.settings = this.mergeWithDefaults(imported);
      
      log.info('Settings imported successfully', {
        module: 'SETTINGS',
        action: 'IMPORT'
      });
      
      this.saveSettings();
      eventBus.emit(Events.SETTINGS_LOADED, this.settings);
      
    } catch (error) {
      log.error('Failed to import settings', {
        module: 'SETTINGS',
        action: 'IMPORT_ERROR'
      }, error as Error);
      
      throw new Error('Invalid settings JSON format');
    }
  }

  /**
   * Configure from URL parameters (for OBS Browser Source)
   */
  public configureFromURLParams(): void {
    const urlParams = new URLSearchParams(window.location.search);
    const updates: Partial<WidgetSettings> = {};
    
    // Check for file cabinet URL override
    const fileCabinetUrl = urlParams.get('fileCabinetUrl');
    if (fileCabinetUrl) {
      updates.googleSheets = { 
        ...this.settings.googleSheets, 
        fileCabinetUrl: decodeURIComponent(fileCabinetUrl) 
      };
    }
    
    // Check for OBS settings
    const obsHost = urlParams.get('obsHost');
    const obsPort = urlParams.get('obsPort');
    if (obsHost || obsPort) {
      updates.obs = { 
        ...this.settings.obs,
        ...(obsHost && { host: obsHost }),
        ...(obsPort && { port: parseInt(obsPort, 10) })
      };
    }
    
    // Check for Singular Live settings
    const singularEndpoint = urlParams.get('singularEndpoint');
    const singularToken = urlParams.get('singularToken');
    if (singularEndpoint || singularToken) {
      updates.singularLive = {
        ...this.settings.singularLive,
        enabled: true,
        ...(singularEndpoint && { dataStreamEndpoint: decodeURIComponent(singularEndpoint) }),
        ...(singularToken && { privateToken: decodeURIComponent(singularToken) })
      };
    }
    
    // Apply updates if any
    if (Object.keys(updates).length > 0) {
      this.settings = this.mergeWithDefaults(updates);
      
      log.info('Settings configured from URL parameters', {
        module: 'SETTINGS',
        action: 'URL_CONFIG',
        data: { updatedSections: Object.keys(updates) }
      });
      
      this.saveSettings();
    }
  }

  /**
   * Get debug information
   */
  public getDebugInfo() {
    return {
      version: this.SETTINGS_VERSION,
      settingsSize: JSON.stringify(this.settings).length,
      sections: Object.keys(this.settings),
      storageKey: this.STORAGE_KEY
    };
  }

  /**
   * Get Google Sheets configuration for the new integration
   */
  public getGoogleSheetsConfig(): import('../integrations/google-sheets/index.js').GoogleSheetsConfig | null {
    const settings = this.getGoogleSheetsSettings();
    
    if (!settings.fileCabinetUrl) {
      return null;
    }

    // Extract spreadsheet ID from URL
    const spreadsheetId = this.extractSpreadsheetId(settings.fileCabinetUrl);
    if (!spreadsheetId) {
      return null;
    }

    return {
      spreadsheetId,
      serviceAccountKey: settings.serviceAccountCredentials || undefined,
      eventSheetName: 'Events',
      operationsSheetName: 'Operations'
    };
  }

  /**
   * Extract spreadsheet ID from Google Sheets URL
   */
  private extractSpreadsheetId(url: string): string | null {
    try {
      const match = url.match(/\/spreadsheets\/d\/([a-zA-Z0-9-_]+)/);
      return match?.[1] || null;
    } catch {
      return null;
    }
  }
}

// Export singleton instance
export const settingsManager = SettingsManager.getInstance();
